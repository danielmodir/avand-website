# Toojibee — Apache / LiteSpeed rules (shared hosting such as cPanel or
# DirectAdmin). Ignored by GitHub Pages and by Nginx. See docs/DEPLOY.md.

# --- HTTPS and one canonical host (toojibee.ir, no www) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://toojibee.ir%{REQUEST_URI} [L,R=301]
  # Admin panel: /p-<random>/ goes to the API's panel.php, which serves
  # the page only for the one secret address and a 404 for any other.
  RewriteRule ^p-[a-z0-9]{24}/?$ api/panel.php [L]
  # Landing pages: the static HTML plus content edited in the admin
  # panel, filled in by api/page.php (no extra request in the browser).
  RewriteRule ^(fa|en)/(index\.html)?$ api/page.php?lang=$1 [L]
  # Articles published from the admin panel (api/articles.php).
  RewriteRule ^(fa|en)/articles/?$ api/articles.php?lang=$1 [L]
  RewriteRule ^(fa|en)/articles/([a-z0-9-]+)/?$ api/articles.php?lang=$1&slug=$2 [L]
  # "Today's date" (api/today.php) and the sitemap with the pages the
  # server makes (today, articles) added to the static sitemap.xml.
  RewriteRule ^(fa|en)/today/?$ api/today.php?lang=$1 [L]
  RewriteRule ^sitemap\.xml$ api/sitemap.php [L]
</IfModule>

# --- Our own illustrated 404 page (works at any path depth) ---
ErrorDocument 404 /404.html

# --- Correct types for the files we serve ---
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType text/javascript .js
</IfModule>

# --- Caching (docs/DEPLOY.md §5) ---
# Pages: always revalidate. /demo/ CSS/JS carry ?v=<version> (bumped on every
# change), and the font never changes name, so those can stay a day.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Every CSS/JS link carries ?v=<version> (bumped on each change) and the
  # font files never change name: keep them a year, no revalidation —
  # repeat visits then load almost nothing on slow networks.
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images and data keep a fixed name when replaced: a week / a day.
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # Basic hardening for a static site.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Compression (smaller pages on slow networks) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# No directory listings.
Options -Indexes
