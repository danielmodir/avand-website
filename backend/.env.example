# Copy to .env and fill in. Never commit .env.

# ── MySQL server (8.0.16+) ───────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
# true = require TLS to the database (always true in production)
DB_SSL=false
# Host the API connects from, used when `npm run db:setup` creates users.
# Keep it narrow: localhost, or the API server's private IP.
DB_CLIENT_HOST=localhost

# Only for `npm run db:setup` (creates databases and users). Use root or
# another admin once, then remove these two lines from the server's .env.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Runs migrations and seeds. Can create/alter tables, no other database.
DB_MIGRATOR_USER=tj_migrator
DB_MIGRATOR_PASSWORD=

# One MySQL user per module database (tj_core, tj_planning, …), data
# access only on its own database. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_CORE_PASSWORD=
DB_PLANNING_PASSWORD=
DB_PERIOD_PASSWORD=
DB_SOCIAL_PASSWORD=
DB_NOTIFICATIONS_PASSWORD=

# ── period encryption ────────────────────────────────────────────────────
# 32-byte master key (KEK), base64. Losing it makes all period data
# unreadable; keep it in a secret store, NOT next to database backups.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PERIOD_KEK_V1=
PERIOD_KEK_CURRENT_VERSION=1

# ── API ──────────────────────────────────────────────────────────────────
JWT_SECRET=
PORT=4000
CORS_ORIGIN=http://localhost:8080
# Uploaded files (storage = local)
UPLOAD_DIR=./uploads
