# Copy to .env and fill in before running. Never commit .env.

# MySQL 8.0.16+ connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://toojibee:change-me@localhost:3306/toojibee

# At least 32 random characters, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

PORT=4000
SESSION_DAYS=30

# Comma-separated origins allowed to call this API (the frontend's real
# origin once one exists; never "*").
CORS_ORIGIN=http://localhost:8080
