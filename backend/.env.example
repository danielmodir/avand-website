# Copy to .env and fill in. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_SECRET_KEY=
JWT_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1
# The web app's origin(s) allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Where links in emails point (verify email, reset password).
FRONTEND_URL=http://localhost:8080/demo/
# Hard-to-guess admin path in production, e.g. manage-7f3k2/
ADMIN_URL=admin/

# ── MySQL (see database/setup.sql) ───────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=false
DB_MIGRATOR_USER=tj_migrator
DB_MIGRATOR_PASSWORD=
DB_CORE_PASSWORD=
DB_CALENDAR_PASSWORD=
DB_PLANNING_PASSWORD=
DB_PERIOD_PASSWORD=
DB_SOCIAL_PASSWORD=
DB_NOTIFICATIONS_PASSWORD=

# ── period encryption ────────────────────────────────────────────────────
# Master key(s), base64 of 32 random bytes:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Losing it makes all period data unreadable. Keep it in a secret store,
# never next to database backups. To rotate: add 2:<new>, set CURRENT=2.
PERIOD_KEKS=1:
PERIOD_KEK_CURRENT=1

# ── Google sign-in ───────────────────────────────────────────────────────
# Web: OAuth client (type "Web application") with this redirect URI registered:
#   https://<api host>/api/v1/auth/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Mobile: client id(s) whose ID tokens auth/google accepts
GOOGLE_CLIENT_IDS=

# ── email ────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Toojibee <no-reply@toojibee.ir>

# Uploaded photos (local storage for now)
UPLOAD_DIR=/var/lib/toojibee/media
# Number of reverse proxies in front of the API (for client IPs).
TRUSTED_PROXIES=0
# Production only: shared cache for rate limits across workers.
REDIS_URL=
