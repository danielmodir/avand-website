# Copy to .env and fill in with a real Postgres instance before running.
DATABASE_URL=postgres://avand:avand@localhost:5432/avand
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma-separated list of origins allowed to call this API (your deployed
# frontend's real origin once one exists — never "*" with credentials on).
CORS_ORIGIN=http://localhost:8080
