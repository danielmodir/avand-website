{
  "name": "toojibee-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for Toojibee on MySQL. Not deployed yet; the demo still uses Supabase. See README.md.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/db.js setup",
    "db:migrate": "node scripts/db.js migrate",
    "db:status": "node scripts/db.js status",
    "db:seed": "node scripts/db.js seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.6"
  },
  "engines": {
    "node": ">=18"
  }
}
