<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: nothing of the app goes into Google/OEM backups
     (the WebView's storage holds the account's copy, period data included).
     allowBackup="false" already says so; this is the belt to its braces. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
