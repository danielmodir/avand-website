<?xml version="1.0" encoding="utf-8"?>
<!-- One day: its number in the app's main calendar, the other calendars'
     small underneath, a filled circle for today. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
    <ImageView android:id="@+id/today" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_gravity="center" android:src="@drawable/widget_dot" android:visibility="gone"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/num" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="8sp" android:includeFontPadding="false" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>