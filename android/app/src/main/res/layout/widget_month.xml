<?xml version="1.0" encoding="utf-8"?>
<!-- The month: arrows and title, weekdays, and the days (rows of
     widget_month_cell, added by Widgets.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="36dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/left" android:layout_width="36dp" android:layout_height="36dp"
                android:padding="7dp" android:src="@drawable/widget_arrow_left" />
            <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
            <ImageView android:id="@+id/right" android:layout_width="36dp" android:layout_height="36dp"
                android:padding="7dp" android:src="@drawable/widget_arrow" />
        </LinearLayout>
        <LinearLayout android:id="@+id/weekdays" android:layout_width="match_parent" android:layout_height="22dp"
            android:orientation="horizontal" />
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>