# /api on the live host. Every /api/v1/... request goes to v1/index.php;
# lib/ and anything else here is never served directly.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Apache drops the Authorization header for PHP unless passed on.
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^v1/index\.php$ - [L]
  # The admin page (served only at its secret address; see panel.php).
  RewriteRule ^panel\.php$ - [L]
  # The landing pages with admin-edited content (see page.php).
  RewriteRule ^page\.php$ - [L]
  RewriteRule ^articles\.php$ - [L]
  RewriteRule ^today\.php$ - [L]
  RewriteRule ^yearcal\.php$ - [L]
  RewriteRule ^monthcal\.php$ - [L]
  RewriteRule ^convert\.php$ - [L]
  RewriteRule ^world-clock\.php$ - [L]
  RewriteRule ^sitemap\.php$ - [L]
  RewriteRule ^v1(/.*)?$ v1/index.php [L,QSA]
  RewriteRule ^ - [F]
</IfModule>
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
