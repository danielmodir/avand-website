# /api on the live host. Every /api/v1/... request goes to v1/index.php;
# lib/ and anything else here is never served directly.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Apache drops the Authorization header for PHP unless passed on.
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^v1/index\.php$ - [L]
  RewriteRule ^v1(/.*)?$ v1/index.php [L,QSA]
  RewriteRule ^ - [F]
</IfModule>
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
