{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "avand-site",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["-y", "http-server", "frontend", "-p", "8080", "-c-1"],
      "port": 8080
    },
    {
      "name": "stage-check",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["-y", "http-server", "dist/stage", "-p", "8090", "-c-1"],
      "port": 8090
    },
    {
      "name": "site-py",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8081", "--directory", "frontend"],
      "port": 8081
    },
    {
      "name": "toojibee-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["backend/manage.py", "runserver", "127.0.0.1:8000", "--noreload"],
      "port": 8000
    }
  ]
}
